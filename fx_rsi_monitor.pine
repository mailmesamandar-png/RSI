//@version=6
// RSI 14 on M5: ONE immediate RSI 70/30 signal per pair.
// Ignore all repeat 70/30 touches until that pair TOUCHES RSI 50 intrabar.
// Touching 50 immediately resets to RANGE and re-arms the pair.
// No M5 candle close is required for signal OR reset.
// Historical OHLC cannot reconstruct intrabar RSI touches.
indicator("FX RSI 3-Pair Monitor | M5 Intrabar Touches -> Telegram", overlay = true)

string eurusdSymbol = input.symbol("OANDA:EURUSD", "EURUSD feed", group = "FX pairs")
string usdjpySymbol = input.symbol("OANDA:USDJPY", "USDJPY feed", group = "FX pairs")
string eurjpySymbol = input.symbol("OANDA:EURJPY", "EURJPY feed", group = "FX pairs")
int rsiLength = input.int(14, "RSI length", minval = 2, group = "RSI")

if timeframe.in_seconds() != 300
    runtime.error("Use this indicator on a 5-minute chart. All three RSI series are M5.")

f_data() =>
    float r = ta.rsi(close, rsiLength)
    [r, ta.crossover(r, 70), ta.crossunder(r, 30), ta.cross(r, 50)]

[eurusdRsi, eurusd70Close, eurusd30Close, eurusd50Close] = request.security(eurusdSymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[usdjpyRsi, usdjpy70Close, usdjpy30Close, usdjpy50Close] = request.security(usdjpySymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[eurjpyRsi, eurjpy70Close, eurjpy30Close, eurjpy50Close] = request.security(eurjpySymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Realtime intrabar RSI observation uses varip (no rollback on each chart tick).
varip float prevEurusdRsi = na
varip float prevUsdjpyRsi = na
varip float prevEurjpyRsi = na

// Each pair has its OWN lockout, released ONLY by touching RSI 50.
// Every touch is intrabar; no 5-minute candle-close confirmation is required.
// 0=RANGE (most recent touch was RSI 50), 1=BUY (70), 2=SELL (30).
varip bool eurusdArmed = true
varip bool usdjpyArmed = true
varip bool eurjpyArmed = true
varip int eurusdState = 0
varip int usdjpyState = 0
varip int eurjpyState = 0
varip int lastEventMs = 0

// A line touch includes landing exactly on the threshold or moving across it
// between observed updates. Repeated RSI 70/30 taps while DISARMED are ignored.
f_touched50(float previous, float current) =>
    not na(previous) and not na(current) and ((current == 50 and previous != 50) or (previous < 50 and current >= 50) or (previous > 50 and current <= 50))

bool eurusdReset = barstate.isrealtime and f_touched50(prevEurusdRsi, eurusdRsi)
bool usdjpyReset = barstate.isrealtime and f_touched50(prevUsdjpyRsi, usdjpyRsi)
bool eurjpyReset = barstate.isrealtime and f_touched50(prevEurjpyRsi, eurjpyRsi)

bool eurusdHit70 = barstate.isrealtime and not na(prevEurusdRsi) and prevEurusdRsi < 70 and eurusdRsi >= 70
bool eurusdHit30 = barstate.isrealtime and not na(prevEurusdRsi) and prevEurusdRsi > 30 and eurusdRsi <= 30
bool usdjpyHit70 = barstate.isrealtime and not na(prevUsdjpyRsi) and prevUsdjpyRsi < 70 and usdjpyRsi >= 70
bool usdjpyHit30 = barstate.isrealtime and not na(prevUsdjpyRsi) and prevUsdjpyRsi > 30 and usdjpyRsi <= 30
bool eurjpyHit70 = barstate.isrealtime and not na(prevEurjpyRsi) and prevEurjpyRsi < 70 and eurjpyRsi >= 70
bool eurjpyHit30 = barstate.isrealtime and not na(prevEurjpyRsi) and prevEurjpyRsi > 30 and eurjpyRsi <= 30

// Effective alerts, as opposed to mere threshold touches.
bool eurusdTouch70 = false
bool eurusdTouch30 = false
bool usdjpyTouch70 = false
bool usdjpyTouch30 = false
bool eurjpyTouch70 = false
bool eurjpyTouch30 = false

if barstate.isrealtime
    // First reset each pair that has JUST touched 50, immediately.
    if eurusdReset
        eurusdState := 0
        eurusdArmed := true
    if usdjpyReset
        usdjpyState := 0
        usdjpyArmed := true
    if eurjpyReset
        eurjpyState := 0
        eurjpyArmed := true

    // Exactly one 70 OR 30 signal per pair until its NEXT RSI 50 touch.
    if eurusdArmed
        if eurusdHit70
            eurusdTouch70 := true
            eurusdState := 1
            eurusdArmed := false
        else if eurusdHit30
            eurusdTouch30 := true
            eurusdState := 2
            eurusdArmed := false
    if usdjpyArmed
        if usdjpyHit70
            usdjpyTouch70 := true
            usdjpyState := 1
            usdjpyArmed := false
        else if usdjpyHit30
            usdjpyTouch30 := true
            usdjpyState := 2
            usdjpyArmed := false
    if eurjpyArmed
        if eurjpyHit70
            eurjpyTouch70 := true
            eurjpyState := 1
            eurjpyArmed := false
        else if eurjpyHit30
            eurjpyTouch30 := true
            eurjpyState := 2
            eurjpyArmed := false
else if barstate.isconfirmed
    // Historical M5 OHLC cannot reveal intrabar RSI touches. Rebuild the
    // starting armed/state values from confirmed historical RSI crossings.
    // THIS DOES NOT impose candle-close confirmation on live signals or reset.
    if eurusd50Close
        eurusdState := 0
        eurusdArmed := true
    if usdjpy50Close
        usdjpyState := 0
        usdjpyArmed := true
    if eurjpy50Close
        eurjpyState := 0
        eurjpyArmed := true

    if eurusdArmed
        if eurusd70Close
            eurusdState := 1
            eurusdArmed := false
        else if eurusd30Close
            eurusdState := 2
            eurusdArmed := false
    if usdjpyArmed
        if usdjpy70Close
            usdjpyState := 1
            usdjpyArmed := false
        else if usdjpy30Close
            usdjpyState := 2
            usdjpyArmed := false
    if eurjpyArmed
        if eurjpy70Close
            eurjpyState := 1
            eurjpyArmed := false
        else if eurjpy30Close
            eurjpyState := 2
            eurjpyArmed := false

// Update each last-observed RSI after detecting this tick's touches.
prevEurusdRsi := eurusdRsi
prevUsdjpyRsi := usdjpyRsi
prevEurjpyRsi := eurjpyRsi

f_state(int state) =>
    state == 1 ? "BUY" : state == 2 ? "SELL" : "RANGE"

f_color(int state) =>
    state == 1 ? color.new(color.green, 5) : state == 2 ? color.new(color.red, 5) : color.new(color.gray, 30)

var table statusTable = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "M5 PAIR", text_color = color.white, bgcolor = color.black)
    table.cell(statusTable, 1, 0, "RSI STATUS", text_color = color.white, bgcolor = color.black)
    table.cell(statusTable, 0, 1, "EURUSD")
    table.cell(statusTable, 1, 1, f_state(eurusdState), text_color = color.white, bgcolor = f_color(eurusdState))
    table.cell(statusTable, 0, 2, "USDJPY")
    table.cell(statusTable, 1, 2, f_state(usdjpyState), text_color = color.white, bgcolor = f_color(usdjpyState))
    table.cell(statusTable, 0, 3, "EURJPY")
    table.cell(statusTable, 1, 3, f_state(eurjpyState), text_color = color.white, bgcolor = f_color(eurjpyState))

// Send an intrabar webhook for EVERY QUALIFIED 70/30 touch.
// Send an immediate SILENT snapshot on each 50 touch (for /status).
// ALSO send a silent snapshot on each M5 close to keep /status current.
// Each snapshot carries all three states and zero-to-three qualified signals.
// The "bar_time" field is now the actual realtime event time, not the
// candle close, so the backend can accept multiple events within one M5 bar.
// alert.freq_all is REQUIRED; once_per_bar_close would drop extra touches.
bool hasTouch = eurusdTouch70 or eurusdTouch30 or usdjpyTouch70 or usdjpyTouch30 or eurjpyTouch70 or eurjpyTouch30
bool hasReset = eurusdReset or usdjpyReset or eurjpyReset
bool emitSnapshot = barstate.isrealtime and (hasTouch or hasReset or barstate.isconfirmed)
if emitSnapshot and not na(eurusdRsi) and not na(usdjpyRsi) and not na(eurjpyRsi)
    string events = ""
    if eurusdTouch70 or eurusdTouch30
        events := "{\"ticker\":\"EURUSD\",\"level\":" + str.tostring(eurusdTouch70 ? 70 : 30) + "}"
    if usdjpyTouch70 or usdjpyTouch30
        events := events + (str.length(events) > 0 ? "," : "") + "{\"ticker\":\"USDJPY\",\"level\":" + str.tostring(usdjpyTouch70 ? 70 : 30) + "}"
    if eurjpyTouch70 or eurjpyTouch30
        events := events + (str.length(events) > 0 ? "," : "") + "{\"ticker\":\"EURJPY\",\"level\":" + str.tostring(eurjpyTouch70 ? 70 : 30) + "}"

    // A monotonic event timestamp prevents deduplication of separate touches
    // that TradingView happens to observe in the same millisecond.
    int eventMs = math.max(timenow, lastEventMs + 1)
    lastEventMs := eventMs
    string states = "\"EURUSD\":\"" + f_state(eurusdState) + "\",\"USDJPY\":\"" + f_state(usdjpyState) + "\",\"EURJPY\":\"" + f_state(eurjpyState) + "\""
    string payload = "{\"version\":1,\"bar_time\":" + str.tostring(eventMs) + ",\"states\":{" + states + "},\"signals\":[" + events + "]}"
    alert(payload, alert.freq_all)
