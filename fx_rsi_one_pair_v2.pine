//@version=6
// ONE dedicated realtime indicator + ONE TradingView alert per FX pair.
// Install separately on OANDA:EURUSD, OANDA:USDJPY, OANDA:EURJPY M5 charts.
// RSI 14: first intrabar touch of 70 or 30 sends ONE signal until RSI
// touches/crosses 50 intrabar (immediate reset). No candle closes required.
// Live reset and signal events are exported for Telegram auditing.
// Historical bars are CLOSE-ONLY approximations, never exact tick replays.
indicator("FX RSI Dedicated Pair V2 | Live Touch Audit", overlay = false, max_labels_count = 500)

int rsiLength = input.int(14, "RSI length", minval = 2)
bool showTouches = input.bool(true, "Show observed realtime touch markers")
if timeframe.in_seconds() != 300
    runtime.error("This indicator requires a 5-minute chart.")
string symbol = syminfo.ticker
if symbol != "EURUSD" and symbol != "USDJPY" and symbol != "EURJPY"
    runtime.error("Chart symbol must be EURUSD, USDJPY or EURJPY.")

float r = ta.rsi(close, rsiLength)
plot(r, title = "Chart-feed RSI", color = color.purple, linewidth = 2)
hline(70, "RSI 70", color = color.red)
hline(50, "Reset RSI 50", color = color.gray)
hline(30, "RSI 30", color = color.green)

varip float prev = na
varip bool armed = true
varip int state = 0  // 0=RANGE, 1=BUY, 2=SELL
varip int lastEventMs = 0

// Reconstruct a reasonable display on historical M5 closes only.
// Do not confuse this with historic intrabar observation.
bool crossed70Close = ta.crossover(r, 70)
bool crossed30Close = ta.crossunder(r, 30)
bool crossed50Close = ta.cross(r, 50)
if not barstate.isrealtime and barstate.isconfirmed
    if crossed50Close
        armed := true
        state := 0
    if armed and crossed70Close
        armed := false
        state := 1
    else if armed and crossed30Close
        armed := false
        state := 2

// Realtime update from the chart's OWN instrument, not request.security()
// sampled by another chart. varip survives Pine rollback between ticks.
bool reset50 = false
int signalLevel = 0
if barstate.isrealtime and not na(prev) and not na(r)
    reset50 := (prev < 50 and r >= 50) or (prev > 50 and r <= 50)
    if reset50
        state := 0
        armed := true
        if showTouches
            label.new(bar_index, 50, "50 RESET", color = color.gray, textcolor = color.white, style = label.style_label_left, size = size.tiny)
    if armed and prev < 70 and r >= 70
        signalLevel := 70
        state := 1
        armed := false
        if showTouches
            label.new(bar_index, 70, "70 SIGNAL", color = color.red, textcolor = color.white, style = label.style_label_down, size = size.tiny)
    else if armed and prev > 30 and r <= 30
        signalLevel := 30
        state := 2
        armed := false
        if showTouches
            label.new(bar_index, 30, "30 SIGNAL", color = color.green, textcolor = color.white, style = label.style_label_up, size = size.tiny)

// Heartbeat every completed M5 bar. Any touch/reset sends immediately.
// reset50 and signalLevel are independent to account for large tick gaps.
bool emit = barstate.isrealtime and (reset50 or signalLevel != 0 or barstate.isconfirmed)
if emit and not na(r)
    int eventTime = math.max(timenow, lastEventMs + 1)
    lastEventMs := eventTime
    string stateText = state == 1 ? "BUY" : state == 2 ? "SELL" : "RANGE"
    string resetText = reset50 ? "true" : "false"
    string payload = "{\"version\":2,\"ticker\":\"" + symbol + "\",\"source\":\"" + syminfo.tickerid + "\",\"event_time\":" + str.tostring(eventTime) + ",\"state\":\"" + stateText + "\",\"rsi\":" + str.tostring(r, "#.#####") + ",\"reset50\":" + resetText + ",\"signal_level\":" + str.tostring(signalLevel) + "}"
    alert(payload, alert.freq_all)

prev := r

var table monitor = table.new(position.top_right, 2, 3, border_width = 1)
if barstate.islast
    table.cell(monitor, 0, 0, symbol, bgcolor = color.black, text_color = color.white)
    table.cell(monitor, 1, 0, "RSI " + str.tostring(r, "#.##"), bgcolor = color.black, text_color = color.white)
    table.cell(monitor, 0, 1, "STATUS")
    table.cell(monitor, 1, 1, state == 1 ? "BUY" : state == 2 ? "SELL" : "RANGE", text_color = color.white, bgcolor = state == 1 ? color.green : state == 2 ? color.red : color.gray)
    table.cell(monitor, 0, 2, "LOCK")
    table.cell(monitor, 1, 2, armed ? "ARMED" : "WAIT RSI 50", text_color = color.white, bgcolor = armed ? color.green : color.orange)
