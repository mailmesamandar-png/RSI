//@version=6
// FINAL SIGNAL TIMING: Only a COMPLETED 5-minute bar can trigger RSI 30/70
// alerts or silently reset at RSI 50. Intrabar RSI touches are ignored.
// The alert lockout is independent for each of the three currency pairs.
indicator("FX RSI 3-Pair Monitor | M5 -> Telegram", overlay = true)

// Exactly three cross-pairs, all from the SAME broker/feed where possible.
// Put the indicator on any 5-minute TradingView chart with regular FX data.
string eurusdSymbol = input.symbol("OANDA:EURUSD", "EURUSD feed", group = "FX pairs")
string usdjpySymbol = input.symbol("OANDA:USDJPY", "USDJPY feed", group = "FX pairs")
string eurjpySymbol = input.symbol("OANDA:EURJPY", "EURJPY feed", group = "FX pairs")
int rsiLength = input.int(14, "RSI length", minval = 2, group = "RSI")

// Using an M5 chart is intentional: remote M5 bars must align with chart bars.
if timeframe.in_seconds() != 300
    runtime.error("Use this indicator on a 5-minute chart. All three RSI series are M5.")

f_data() =>
    float r = ta.rsi(close, rsiLength)
    bool crossed70 = ta.crossover(r, 70)
    bool crossed30 = ta.crossunder(r, 30)
    bool crossed50 = ta.cross(r, 50)
    [r, crossed70, crossed30, crossed50]

[eurusdRsi, eurusd70, eurusd30, eurusd50] = request.security(eurusdSymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[usdjpyRsi, usdjpy70, usdjpy30, usdjpy50] = request.security(usdjpySymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[eurjpyRsi, eurjpy70, eurjpy30, eurjpy50] = request.security(eurjpySymbol, "5", f_data(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// State codes: 0=RANGE (last crossed 50), 1=BUY (last crossed 70),
//              2=SELL (last crossed 30).
// Alert lockout is PER PAIR, not shared: a different pair can alert simultaneously.
var int eurusdState = 0
var int usdjpyState = 0
var int eurjpyState = 0
var bool eurusdArmed = true
var bool usdjpyArmed = true
var bool eurjpyArmed = true

int eurusdSignal = 0
int usdjpySignal = 0
int eurjpySignal = 0

// Commit RSI crossings and lockout resets ONLY at the 5-minute candle close.
// No intrabar event may change a persistent state or send a notification.
if barstate.isconfirmed
    if not na(eurusdRsi)
        if eurusd50
            eurusdState := 0
            eurusdArmed := true
        if eurusdArmed and eurusd70
            eurusdState := 1
            eurusdArmed := false
            eurusdSignal := 70
        else if eurusdArmed and eurusd30
            eurusdState := 2
            eurusdArmed := false
            eurusdSignal := 30

    if not na(usdjpyRsi)
        if usdjpy50
            usdjpyState := 0
            usdjpyArmed := true
        if usdjpyArmed and usdjpy70
            usdjpyState := 1
            usdjpyArmed := false
            usdjpySignal := 70
        else if usdjpyArmed and usdjpy30
            usdjpyState := 2
            usdjpyArmed := false
            usdjpySignal := 30

    if not na(eurjpyRsi)
        if eurjpy50
            eurjpyState := 0
            eurjpyArmed := true
        if eurjpyArmed and eurjpy70
            eurjpyState := 1
            eurjpyArmed := false
            eurjpySignal := 70
        else if eurjpyArmed and eurjpy30
            eurjpyState := 2
            eurjpyArmed := false
            eurjpySignal := 30

f_state(int state) =>
    state == 1 ? "BUY" : state == 2 ? "SELL" : "RANGE"

f_color(int state) =>
    state == 1 ? color.new(color.green, 5) : state == 2 ? color.new(color.red, 5) : color.new(color.gray, 30)

// Optional chart table. It never makes trade decisions.
var table statusTable = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, "M5 PAIR", text_color = color.white, bgcolor = color.black)
    table.cell(statusTable, 1, 0, "RSI STATUS", text_color = color.white, bgcolor = color.black)
    table.cell(statusTable, 0, 1, "EURUSD")
    table.cell(statusTable, 1, 1, f_state(eurusdState), text_color = color.white, bgcolor = f_color(eurusdState))
    table.cell(statusTable, 0, 2, "USDJPY")
    table.cell(statusTable, 1, 2, f_state(usdjpyState), text_color = color.white, bgcolor = f_color(usdjpyState))
    table.cell(statusTable, 0, 3, "EURJPY")
    table.cell(statusTable, 1, 3, f_state(eurjpyState), text_color = color.white, bgcolor = f_color(eurjpyState))

// Exactly ONE webhook payload per confirmed, live M5 candle.
// alert.freq_once_per_bar_close is a second guard against intrabar alerts.
// It includes all three states, and ZERO TO THREE events. The Telegram backend
// only posts events, while every payload updates the on-demand /status report.
// A reset at 50 produces NO Telegram message.
if barstate.isconfirmed and barstate.isrealtime and not na(eurusdRsi) and not na(usdjpyRsi) and not na(eurjpyRsi)
    string events = ""
    if eurusdSignal != 0
        events := "{\"ticker\":\"EURUSD\",\"level\":" + str.tostring(eurusdSignal) + "}"
    if usdjpySignal != 0
        events := events + (str.length(events) > 0 ? "," : "") + "{\"ticker\":\"USDJPY\",\"level\":" + str.tostring(usdjpySignal) + "}"
    if eurjpySignal != 0
        events := events + (str.length(events) > 0 ? "," : "") + "{\"ticker\":\"EURJPY\",\"level\":" + str.tostring(eurjpySignal) + "}"

    string states = "\"EURUSD\":\"" + f_state(eurusdState) + "\"," + "\"USDJPY\":\"" + f_state(usdjpyState) + "\"," + "\"EURJPY\":\"" + f_state(eurjpyState) + "\""
    string payload = "{\"version\":1,\"bar_time\":" + str.tostring(time_close) + ",\"states\":{" + states + "},\"signals\":[" + events + "]}"
    alert(payload, alert.freq_once_per_bar_close)