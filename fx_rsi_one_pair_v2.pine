//@version=6
// FX RSI Dedicated Pair V2.1 — one TradingView chart and alert per instrument.
// Chart: OANDA:EURUSD, OANDA:USDJPY, or OANDA:EURJPY on 5 minutes.
// One RSI 70/30 signal immediately; RSI 50 touch immediately unlocks.
// Historical bars are M5 close approximations, not tick-level replays.
indicator("FX RSI Dedicated Pair V2.1 | Touch Audit", overlay=false)

int rsiLength = input.int(14, "RSI length", minval=2)
bool showTouches = input.bool(true, "Show live touch markers")
if timeframe.in_seconds() != 300
    runtime.error("Set the chart timeframe to 5 minutes.")
string ticker = syminfo.ticker
if ticker != "EURUSD" and ticker != "USDJPY" and ticker != "EURJPY"
    runtime.error("Use an EURUSD, USDJPY or EURJPY chart.")
if syminfo.prefix != "OANDA"
    runtime.error("Use the matching OANDA forex chart for Telegram.")

float r = ta.rsi(close, rsiLength)
plot(r, "RSI 14", color=color.purple, linewidth=2)
hline(70, "RSI 70", color=color.red)
hline(50, "RSI 50 reset", color=color.gray)
hline(30, "RSI 30", color=color.green)

varip float previousRsi = na
varip bool armed = true
varip int currentState = 0
varip int lastEventMs = 0

// Global historical calculations. Historical bars cannot reveal intrabar ticks.
bool historical70 = ta.crossover(r, 70)
bool historical30 = ta.crossunder(r, 30)
bool historical50 = ta.cross(r, 50)
bool validTick = barstate.isrealtime and not na(previousRsi) and not na(r)
bool liveReset = validTick and ((previousRsi < 50 and r >= 50) or (previousRsi > 50 and r <= 50))
bool historyReset = barstate.ishistory and historical50
bool resetNow = liveReset or historyReset
bool canSignal = armed or resetNow

bool touch70 = canSignal and ((validTick and previousRsi < 70 and r >= 70) or (barstate.ishistory and historical70))
bool touch30 = canSignal and ((validTick and previousRsi > 30 and r <= 30) or (barstate.ishistory and historical30))
int signalLevel = touch70 ? 70 : touch30 ? 30 : 0

// Exactly one event until the next 50 touch. No candle-close wait in live trading.
currentState := signalLevel == 70 ? 1 : signalLevel == 30 ? 2 : resetNow ? 0 : currentState
armed := signalLevel != 0 ? false : resetNow ? true : armed
previousRsi := r

// Only draw markers for realtime touches, not reconstructed historical M5 bars.
plotshape(showTouches and liveReset ? 50.0 : na, title="RSI 50 reset", location=location.absolute, style=shape.circle, color=color.gray, size=size.tiny)
plotshape(showTouches and validTick and signalLevel == 70 ? 70.0 : na, title="RSI 70 signal", location=location.absolute, style=shape.triangledown, color=color.red, size=size.small)
plotshape(showTouches and validTick and signalLevel == 30 ? 30.0 : na, title="RSI 30 signal", location=location.absolute, style=shape.triangleup, color=color.green, size=size.small)

// Heartbeat at each M5 close; touches and resets are transmitted immediately.
// Backend receives one v2 event per chart and records delivery and reset audits.
bool sendNow = barstate.isrealtime and (liveReset or signalLevel != 0 or barstate.isconfirmed)
if sendNow and not na(r)
    int eventMs = math.max(timenow, lastEventMs + 1)
    lastEventMs := eventMs
    string stateText = currentState == 1 ? "BUY" : currentState == 2 ? "SELL" : "RANGE"
    string resetText = liveReset ? "true" : "false"
    string payload = "{\"version\":2,\"ticker\":\"" + ticker + "\",\"source\":\"" + syminfo.tickerid + "\",\"event_time\":" + str.tostring(eventMs) + ",\"state\":\"" + stateText + "\",\"rsi\":" + str.tostring(r, "#.#####") + ",\"reset50\":" + resetText + ",\"signal_level\":" + str.tostring(signalLevel) + "}"
    alert(payload, alert.freq_all)

var table monitor = table.new(position.top_right, 2, 3, border_width=1)
if barstate.islast
    table.cell(monitor, 0, 0, ticker, bgcolor=color.black, text_color=color.white)
    table.cell(monitor, 1, 0, "RSI " + str.tostring(r, "#.##"), bgcolor=color.black, text_color=color.white)
    table.cell(monitor, 0, 1, "STATUS")
    table.cell(monitor, 1, 1, currentState == 1 ? "BUY" : currentState == 2 ? "SELL" : "RANGE", text_color=color.white, bgcolor=currentState == 1 ? color.green : currentState == 2 ? color.red : color.gray)
    table.cell(monitor, 0, 2, "LOCK")
    table.cell(monitor, 1, 2, armed ? "ARMED" : "WAIT RSI 50", text_color=color.white, bgcolor=armed ? color.green : color.orange)
